# GEMINI_API_KEY: Clave de Google AI Studio / Gemini API (Obligatoria para la IA).
# Inyectada automáticamente en AI Studio. En producción o local, configúrala como variable de entorno del servidor.
GEMINI_API_KEY="AIzaSy..."

# VITE_GOOGLE_MAPS_API_KEY: Clave de Google Maps Platform (JavaScript Maps, Places, Routes).
# Debe restringirse por HTTP Referrer para el dominio de tu app.
VITE_GOOGLE_MAPS_API_KEY="AIzaSy..."

# OPENWEATHER_API_KEY: Clave opcional para el proveedor de OpenWeatherMap.
# Si no se proporciona o si el servicio no responde, la app se degrada elegantemente
# usando Open-Meteo o indicando "tiempo no disponible" sin interrumpir la creación de itinerarios.
OPENWEATHER_API_KEY=""

# APP_URL: URL base pública de la aplicación.
APP_URL="https://ais-dev-szgujsugmvn43o6kllj6bf-997611849278.europe-west2.run.app"
