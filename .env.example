# ==============================================================================
# TASTELOCAL LIVING - VARIABLES DE ENTORNO PARA PRODUCCIÓN & DESARROLLO
# ==============================================================================

# 1. SERVIDOR & PUERTO (Render / Railway asignan PORT automáticamente)
PORT=3000
NODE_ENV=production

# 2. GEMINI API (Obligatoria para la IA contextual, mood y generación de itinerarios)
# Obtén tu clave gratuita en: https://aistudio.google.com/
GEMINI_API_KEY="AIzaSy..."

# 3. GOOGLE MAPS PLATFORM & PLACES API
# Utilizada para renderizar mapas interactivos, autocompletado y validación de lugares 100% reales.
GOOGLE_PLACES_API_KEY="AIzaSy..."
GOOGLE_MAPS_API_KEY="AIzaSy..."
VITE_GOOGLE_MAPS_API_KEY="AIzaSy..."

# 4. POLÍTICA DE SEGURIDAD CORS (Opcional)
# Dominio o lista separada por comas de orígenes permitidos. Dejar vacío o '*' para permitir el dominio asignado.
ALLOWED_ORIGIN="https://mi-tastelocal-app.vercel.app,https://tastelocal.onrender.com"

# 5. URL DEL BACKEND PARA EL FRONTEND (Solo si despliegas frontend y backend por separado)
# En despliegue unificado (Full-Stack en Render/Railway) dejar vacío.
# Si el frontend está en Vercel y el backend en Render:
# VITE_API_URL="https://tastelocal-backend.onrender.com"
VITE_API_URL=""

# 6. METEOROLOGÍA (Opcional)
# Si se deja vacío, la app utiliza automáticamente el fallback gratuito de Open-Meteo sin romper el servicio.
OPENWEATHER_API_KEY=""
